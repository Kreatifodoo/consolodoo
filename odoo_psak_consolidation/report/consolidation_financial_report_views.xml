<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Register Action Report -->
    <record id="action_report_consolidation_financial" model="ir.actions.report">
        <field name="name">Consolidation Financial Report</field>
        <field name="model">consolidation.report.viewer</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">odoo_psak_consolidation.report_financial_pdf</field>
        <field name="print_report_name">'Financial Report'</field>
        <field name="binding_model_id" eval="False"/>
    </record>

    <!-- QWeb Template -->
    <template id="report_financial_pdf">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <div class="text-center mb-4">
                        <h2><t t-out="report_data.get('report_name')"/></h2>
                        <h4 t-if="report_data.get('date_from') or report_data.get('date_to')">
                            <span t-if="report_data.get('date_from')"><t t-out="report_data.get('date_from')"/></span>
                            <span t-if="report_data.get('date_from') and report_data.get('date_to')"> to </span>
                            <span t-if="report_data.get('date_to')"><t t-out="report_data.get('date_to')"/></span>
                        </h4>
                    </div>

                    <table class="table table-sm o_main_table table-borderless">
                        <thead>
                            <tr style="border-bottom: 2px solid black;">
                                <th>Name</th>
                                <th>Code</th>
                                <th class="text-end">Balance</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="report_data.get('lines', [])" t-as="line">
                                <tr>
                                    <td t-att-style="'padding-left: ' + str(line.get('level', 0) * 20) + 'px; ' + ('font-weight: bold;' if line.get('type') == 'view' else '')">
                                        <span t-out="line.get('name')"/>
                                    </td>
                                    <td t-att-style="('font-weight: bold;' if line.get('type') == 'view' else '')">
                                        <span t-out="line.get('code')"/>
                                    </td>
                                    <td class="text-end" t-att-style="('font-weight: bold;' if line.get('type') == 'view' else '')">
                                        <span t-out="line.get('balance')" t-options="{'widget': 'monetary', 'display_currency': docs.env.company.currency_id}"/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>

</odoo>
