<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="odoo_psak_consolidation.XbrlReportViewer" owl="1">
        <div class="o_action_manager">
            <div class="o_xbrl_report_viewer h-100 d-flex flex-column">
                <!-- Control Panel -->
                <div class="o_control_panel p-3 border-bottom bg-white d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <div class="d-flex align-items-center gap-3">
                        <h2 class="m-0 text-primary">XBRL Consolidation Report</h2>
                        
                        <div class="input-group w-auto">
                            <span class="input-group-text">Template</span>
                            <select class="form-select" t-att-value="this.state.selectedReportId" t-on-input="(ev) => this.state.selectedReportId = ev.target.value">
                                <t t-foreach="this.state.availableReports" t-as="report" t-key="report.id">
                                    <option t-att-value="report.id"><t t-out="report.name"/></option>
                                </t>
                            </select>
                        </div>

                        <div class="input-group w-auto">
                            <span class="input-group-text">From</span>
                            <input type="date" class="form-control" t-att-value="this.state.dateFrom" t-on-input="(ev) => this.state.dateFrom = ev.target.value"/>
                        </div>
                        <div class="input-group w-auto">
                            <span class="input-group-text">To</span>
                            <input type="date" class="form-control" t-att-value="this.state.dateTo" t-on-input="(ev) => this.state.dateTo = ev.target.value"/>
                        </div>
                        
                        <button class="btn btn-primary" t-on-click="this.loadData">Apply</button>
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn btn-outline-secondary" t-on-click="this.exportExcel"><i class="fa fa-file-excel-o"/> Excel</button>
                        <button class="btn btn-outline-secondary" t-on-click="this.exportPdf"><i class="fa fa-file-pdf-o"/> PDF</button>
                    </div>
                </div>

                <!-- Report Body -->
                <div class="o_content flex-grow-1 overflow-auto bg-view p-4">
                    <table class="table table-hover table-sm o_xbrl_table">
                        <thead class="bg-white sticky-top shadow-sm">
                            <tr>
                                <th>Description</th>
                                <th class="text-end">Balance</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-if="!this.state.selectedReportId">
                                <tr><td colspan="2" class="text-center text-muted p-5">Please select a Report Template.</td></tr>
                            </t>
                            <t t-elif="this.state.reportData.length == 0">
                                <tr><td colspan="2" class="text-center text-muted p-5">No data available or click Apply to load.</td></tr>
                            </t>
                            <t t-foreach="this.state.reportData" t-as="line" t-key="line.id">
                                <tr t-att-class="this.getLineClass(line)">
                                    <td t-attf-style="padding-left: {{ line.indent * 20 + 10 }}px;" class="position-relative">
                                        <t t-if="line.has_children">
                                            <i t-attf-class="fa fa-caret-{{ line.is_unfolded ? 'down' : 'right' }} me-2 cursor-pointer text-muted"
                                               t-on-click="() => this.toggleFold(line)"/>
                                        </t>
                                        <span t-att-title="line.code ? 'Code: ' + line.code : ''">
                                            <t t-out="line.name"/>
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <t t-if="line.type === 'coa_line'">
                                            <a href="#" t-on-click.prevent="() => this.drillDown(line)" class="text-decoration-none">
                                                <t t-out="this.formatCurrency(line.balance)"/>
                                            </a>
                                        </t>
                                        <span t-else="">
                                            <t t-out="this.formatCurrency(line.balance)"/>
                                        </span>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </t>
</templates>
