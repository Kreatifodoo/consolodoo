<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_consolidation_report_viewer_form" model="ir.ui.view">
        <field name="name">consolidation.report.viewer.form</field>
        <field name="model">consolidation.report.viewer</field>
        <field name="arch" type="xml">
            <form string="Financial Report Viewer">
                <group>
                    <group>
                        <field name="report_id" widget="selection"/>
                        <field name="period_ids" widget="many2many_tags" placeholder="Select multiple periods to combine..."/>
                    </group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                </group>
                <footer>
                    <button name="action_view_report" string="View Report" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_consolidation_report_viewer" model="ir.actions.act_window">
        <field name="name">Financial Reports</field>
        <field name="res_model">consolidation.report.viewer</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
