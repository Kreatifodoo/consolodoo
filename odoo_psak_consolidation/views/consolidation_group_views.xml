<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_consolidation_group_form" model="ir.ui.view">
        <field name="name">consolidation.group.form</field>
        <field name="model">consolidation.group</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="parent_company_id"/>
                        <field name="consolidation_currency_id"/>
                        <field name="nci_equity_account_id"/>
                    </group>
                    <notebook>
                        <page string="Subsidiaries">
                            <field name="company_ids">
                                <list editable="bottom">
                                    <field name="company_id"/>
                                    <field name="ownership_percentage"/>
                                    <field name="nci_percentage"/>
                                    <field name="consolidation_method"/>
                                    <field name="acquisition_date"/>
                                    <field name="equity_at_acquisition"/>
                                    <field name="investment_cost"/>
                                    <field name="goodwill"/>
                                    <field name="nci_at_acquisition"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="equity_account_id" optional="hide"/>
                                    <field name="investment_account_id" optional="hide"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_consolidation_group" model="ir.actions.act_window">
        <field name="name">Consolidation Groups</field>
        <field name="res_model">consolidation.group</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
