<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_consol_journal_tree" model="ir.ui.view">
        <field name="name">consol.journal.tree</field>
        <field name="model">consol.journal</field>
        <field name="arch" type="xml">
            <list string="Jurnal Eliminasi Konsolidasi" decoration-muted="state == 'draft'">
                <field name="period_id"/>
                <field name="code"/>
                <field name="name"/>
                <field name="origin"/>
                <field name="total_debit"/>
                <field name="total_credit"/>
                <field name="recurring"/>
                <field name="auto_reverse"/>
                <field name="state" widget="badge" decoration-success="state == 'posted'" decoration-info="state == 'draft'"/>
            </list>
        </field>
    </record>

    <record id="view_consol_journal_form" model="ir.ui.view">
        <field name="name">consol.journal.form</field>
        <field name="model">consol.journal</field>
        <field name="arch" type="xml">
            <form string="Jurnal Eliminasi">
                <header>
                    <button name="action_post" string="Posting Jurnal" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_reset_draft" string="Kembalikan ke Draf" type="object" invisible="state != 'posted'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="code" string="Kode Jurnal (E1..E10 / MANUAL)"/>
                        <h1>
                            <field name="code" readonly="state == 'posted'"/>
                        </h1>
                        <label for="name" string="Deskripsi Jurnal"/>
                        <h2>
                            <field name="name" readonly="state == 'posted'"/>
                        </h2>
                    </div>
                    <group>
                        <group>
                            <field name="period_id" readonly="state == 'posted'"/>
                            <field name="origin" readonly="1"/>
                            <field name="rule_id" invisible="origin != 'auto'" readonly="1"/>
                        </group>
                        <group>
                            <field name="recurring" readonly="state == 'posted'"/>
                            <field name="auto_reverse" readonly="state == 'posted'"/>
                            <field name="reversed_from_id" invisible="not reversed_from_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Baris Jurnal Eliminasi">
                            <field name="line_ids" readonly="state == 'posted'">
                                <list editable="bottom">
                                    <field name="consol_account_id"/>
                                    <field name="entity_id"/>
                                    <field name="partner_entity_id"/>
                                    <field name="debit" sum="Total Debit"/>
                                    <field name="credit" sum="Total Credit"/>
                                    <field name="nci_share"/>
                                    <field name="note"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="total_debit"/>
                                <field name="total_credit"/>
                            </group>
                        </page>
                        <page string="Dasar PSAK / Catatan Pendukung">
                            <field name="note" placeholder="Referensi standar akuntansi dan perhitungan kertas kerja..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_consol_journal" model="ir.actions.act_window">
        <field name="name">Jurnal Eliminasi</field>
        <field name="res_model">consol.journal</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Kelola jurnal eliminasi otomatis (E1-E10) dan jurnal penyesuaian manual!
            </p>
        </field>
    </record>
</odoo>
