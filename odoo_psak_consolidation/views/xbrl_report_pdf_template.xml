<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_xbrl_consolidation">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2>XBRL Consolidation Report</h2>
                    <p>
                        <strong>Period: </strong> <t t-out="date_from"/> to <t t-out="date_to"/>
                    </p>
                    
                    <table class="table table-sm table-bordered">
                        <thead>
                            <tr>
                                <th>Description</th>
                                <th class="text-end">Balance</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="lines" t-as="line">
                                <tr t-att-style="line['indent'] == 0 and 'font-weight: bold; background-color: #f8f9fa;' or (line['type'] == 'coa_line' and 'color: #495057; font-size: 0.9em;' or '')">
                                    <td t-attf-style="padding-left: {{ line['indent'] * 20 + 10 }}px;">
                                        <span t-att-title="line.get('code', '')">
                                            <t t-out="line['name']"/>
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <t t-out="'{0:,.2f}'.format(line['balance'])"/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
    
    <record id="action_report_xbrl_consolidation" model="ir.actions.report">
        <field name="name">XBRL Consolidation Report</field>
        <field name="model">consolidation.xbrl.report.engine</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">odoo_psak_consolidation.report_xbrl_consolidation</field>
        <field name="binding_type">report</field>
    </record>
</odoo>
