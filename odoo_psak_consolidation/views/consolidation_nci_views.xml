<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_consolidation_nci_list" model="ir.ui.view">
        <field name="name">consolidation.nci.list</field>
        <field name="model">consolidation.nci</field>
        <field name="arch" type="xml">
            <list string="NCI Tracking" create="false" delete="false">
                <field name="member_id"/>
                <field name="period_id"/>
                <field name="opening_balance"/>
                <field name="income_allocation"/>
                <field name="closing_balance"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>
    <record id="action_consolidation_nci" model="ir.actions.act_window">
        <field name="name">NCI Tracking</field>
        <field name="res_model">consolidation.nci</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
