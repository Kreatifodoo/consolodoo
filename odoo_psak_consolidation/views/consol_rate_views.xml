<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_consol_rate_tree" model="ir.ui.view">
        <field name="name">consol.rate.tree</field>
        <field name="model">consol.rate</field>
        <field name="arch" type="xml">
            <list string="Consolidation Exchange Rates" editable="bottom">
                <field name="period_id"/>
                <field name="group_id"/>
                <field name="currency_id"/>
                <field name="closing_rate"/>
                <field name="average_rate"/>
                <field name="historical_rate"/>
                <field name="is_custom"/>
            </list>
        </field>
    </record>

    <record id="action_consol_rate" model="ir.actions.act_window">
        <field name="name">Consolidation Exchange Rates</field>
        <field name="res_model">consol.rate</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
