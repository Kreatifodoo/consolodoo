<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_consolidation_rule_list" model="ir.ui.view">
        <field name="name">consolidation.rule.list</field>
        <field name="model">consolidation.rule</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="rule_type"/>
                <field name="partner_match_type"/>
            </list>
        </field>
    </record>

    <record id="action_consolidation_rule" model="ir.actions.act_window">
        <field name="name">Rules</field>
        <field name="res_model">consolidation.rule</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
