<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Report Header Tree View -->
    <record id="view_consolidation_xbrl_report_tree" model="ir.ui.view">
        <field name="name">consolidation.xbrl.report.tree</field>
        <field name="model">consolidation.xbrl.report</field>
        <field name="arch" type="xml">
            <list string="XBRL Reports">
                <field name="name"/>
                <field name="code"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>

    <!-- Report Header Form View -->
    <record id="view_consolidation_xbrl_report_form" model="ir.ui.view">
        <field name="name">consolidation.xbrl.report.form</field>
        <field name="model">consolidation.xbrl.report</field>
        <field name="arch" type="xml">
            <form string="XBRL Report">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Report Name..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="company_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Report Lines">
                            <field name="line_ids">
                                <list string="XBRL Report Lines">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="report_type"/>
                                    <field name="parent_id"/>
                                    <field name="sign"/>
                                </list>
                            </field>
                        </page>
                        <page string="Description">
                            <field name="description" placeholder="Optional description..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Form view for Report Lines when opened from One2many or directly -->
    <record id="view_consolidation_xbrl_report_line_form" model="ir.ui.view">
        <field name="name">consolidation.xbrl.report.line.form</field>
        <field name="model">consolidation.xbrl.report.line</field>
        <field name="arch" type="xml">
            <form string="XBRL Report Line">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Report Line Name..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="report_type"/>
                            <field name="parent_id"/>
                        </group>
                        <group>
                            <field name="sign"/>
                            <field name="is_elimination_target"/>
                            <field name="sequence"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Master COA Mapping">
                            <field name="master_coa_ids" widget="many2many">
                                <list>
                                    <field name="code"/>
                                    <field name="name"/>
                                </list>
                            </field>
                        </page>
                        <page string="Sub-Lines">
                            <field name="child_ids">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="sign"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_consolidation_xbrl_report" model="ir.actions.act_window">
        <field name="name">Consolidation Report Mapping</field>
        <field name="res_model">consolidation.xbrl.report</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menus -->
    <menuitem id="menu_consolidation_xbrl_root" 
              name="XBRL" 
              parent="odoo_psak_consolidation.menu_consolidation_config" 
              sequence="100"/>
              
    <menuitem id="menu_consolidation_xbrl_report_mapping" 
              name="Consolidation Report Mapping" 
              parent="menu_consolidation_xbrl_root" 
              action="action_consolidation_xbrl_report" 
              sequence="10"/>
</odoo>
