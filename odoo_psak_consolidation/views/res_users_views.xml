<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_consol_inherit" model="ir.ui.view">
        <field name="name">res.users.form.consol.inherit</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Consolidation Access" groups="odoo_psak_consolidation.group_consolidation_manager">
                    <group>
                        <field name="consol_group_ids" widget="many2many_tags"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
