<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_consol_entity_tree" model="ir.ui.view">
        <field name="name">consol.entity.tree</field>
        <field name="model">consol.entity</field>
        <field name="arch" type="xml">
            <list string="Consolidation Entities">
                <field name="code"/>
                <field name="name"/>
                <field name="company_id"/>
                <field name="source_type"/>
                <field name="functional_currency_id"/>
                <field name="partner_id"/>
                <field name="is_investment_entity"/>
            </list>
        </field>
    </record>

    <record id="view_consol_entity_form" model="ir.ui.view">
        <field name="name">consol.entity.form</field>
        <field name="model">consol.entity</field>
        <field name="arch" type="xml">
            <form string="Consolidation Entity">
                <sheet>
                    <div class="oe_title">
                        <label for="code" string="Entity Short Code (Worksheet Header)"/>
                        <h1>
                            <field name="code" placeholder="e.g. PT_ABC"/>
                        </h1>
                        <label for="name" string="Entity Full Name"/>
                        <h2>
                            <field name="name" placeholder="e.g. PT ABC Industry"/>
                        </h2>
                    </div>
                    <group>
                        <group string="Profile &amp; Data Source">
                            <field name="source_type"/>
                            <field name="company_id" invisible="source_type != 'odoo'"/>
                            <field name="functional_currency_id"/>
                            <field name="partner_id"/>
                        </group>
                        <group string="Special Provisions (PSAK 65)">
                            <field name="is_investment_entity"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Ownership Structure (Owned By)">
                            <field name="parent_ownership_ids">
                                <list editable="bottom">
                                    <field name="parent_id"/>
                                    <field name="percentage"/>
                                    <field name="effective_percentage"/>
                                    <field name="nci_percentage" decoration-danger="nci_percentage &gt; 0"/>
                                    <field name="method"/>
                                    <field name="date_from"/>
                                    <field name="date_to"/>
                                </list>
                            </field>
                        </page>
                        <page string="Investment in Other Entities (Owns)">
                            <field name="child_ownership_ids">
                                <list editable="bottom">
                                    <field name="child_id"/>
                                    <field name="percentage"/>
                                    <field name="effective_percentage"/>
                                    <field name="nci_percentage" decoration-danger="nci_percentage &gt; 0"/>
                                    <field name="method"/>
                                    <field name="goodwill_amount"/>
                                    <field name="nci_at_acquisition"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_consol_entity" model="ir.actions.act_window">
        <field name="name">Consolidation Entities</field>
        <field name="res_model">consol.entity</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Register parent entities and subsidiaries for consolidation!
            </p>
        </field>
    </record>
</odoo>
