<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Report Line Form View -->
    <record id="view_consolidation_report_line_form" model="ir.ui.view">
        <field name="name">consolidation.report.line.form</field>
        <field name="model">consolidation.report.line</field>
        <field name="arch" type="xml">
            <form string="Report Line">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="line_type"/>
                            <field name="sign" invisible="line_type == 'view'"/>
                            <field name="formula" invisible="line_type != 'formula'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Accounts" invisible="line_type != 'accounts'">
                            <field name="account_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Report Form View -->
    <record id="view_consolidation_report_form" model="ir.ui.view">
        <field name="name">consolidation.report.form</field>
        <field name="model">consolidation.report</field>
        <field name="arch" type="xml">
            <form string="Financial Report Configuration">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Report Name"/>
                        </h1>
                    </div>
                    <group>
                        <field name="active"/>
                    </group>
                    <notebook>
                        <page string="Report Lines">
                            <field name="line_ids">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="line_type"/>
                                    <field name="sign"/>
                                    <field name="formula"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Report Tree View -->
    <record id="view_consolidation_report_tree" model="ir.ui.view">
        <field name="name">consolidation.report.tree</field>
        <field name="model">consolidation.report</field>
        <field name="arch" type="xml">
            <list string="Financial Reports Configuration">
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="action_consolidation_report" model="ir.actions.act_window">
        <field name="name">Financial Reports Config</field>
        <field name="res_model">consolidation.report</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
