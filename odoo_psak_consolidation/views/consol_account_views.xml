<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_consol_account_tree" model="ir.ui.view">
        <field name="name">consol.account.tree</field>
        <field name="model">consol.account</field>
        <field name="arch" type="xml">
            <list string="Bagan Akun Konsolidasi">
                <header>
                    <button name="action_open_import_company_coa_wizard"
                            type="object"
                            string="Salin dari Master Akun Perusahaan"
                            class="btn-primary"
                            icon="download"/>
                </header>
                <field name="code"/>
                <field name="name"/>
                <field name="account_type"/>
                <field name="statement"/>
                <field name="translation_rate"/>
                <field name="is_intercompany"/>
                <field name="ic_counterpart_id"/>
            </list>
        </field>
    </record>

    <record id="view_consol_account_form" model="ir.ui.view">
        <field name="name">consol.account.form</field>
        <field name="model">consol.account</field>
        <field name="arch" type="xml">
            <form string="Akun Konsolidasi">
                <sheet>
                    <div class="oe_title">
                        <label for="code" string="Kode Akun"/>
                        <h1>
                            <field name="code" placeholder="Contoh: 101000"/>
                        </h1>
                        <label for="name" string="Nama Akun"/>
                        <h2>
                            <field name="name" placeholder="Contoh: Kas dan Setara Kas"/>
                        </h2>
                    </div>
                    <group>
                        <group string="Klasifikasi Akun">
                            <field name="account_type"/>
                            <field name="statement"/>
                            <field name="translation_rate"/>
                            <field name="parent_id"/>
                        </group>
                        <group string="Pengaturan Antar-Perusahaan (Intercompany)">
                            <field name="is_intercompany"/>
                            <field name="ic_counterpart_id" invisible="not is_intercompany"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Sub-Akun" invisible="not child_ids">
                            <field name="child_ids" readonly="1">
                                <list>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="account_type"/>
                                </list>
                            </field>
                        </page>
                        <page string="Catatan">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_consol_account_search" model="ir.ui.view">
        <field name="name">consol.account.search</field>
        <field name="model">consol.account</field>
        <field name="arch" type="xml">
            <search string="Cari Akun Konsolidasi">
                <field name="name"/>
                <field name="code"/>
                <filter string="Neraca (Posisi Keuangan)" name="filter_bs" domain="[('statement', '=', 'bs')]"/>
                <filter string="Laba Rugi" name="filter_pl" domain="[('statement', '=', 'pl')]"/>
                <filter string="Akun Antar-Perusahaan (IC)" name="filter_ic" domain="[('is_intercompany', '=', True)]"/>
                <group>
                    <filter string="Kelompok Laporan" name="group_statement" domain="" context="{'group_by': 'statement'}"/>
                    <filter string="Tipe Akun" name="group_account_type" domain="" context="{'group_by': 'account_type'}"/>
                    <filter string="Tipe Kurs Translasi" name="group_translation" domain="" context="{'group_by': 'translation_rate'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_consol_account" model="ir.actions.act_window">
        <field name="name">Bagan Akun Konsolidasi (COA)</field>
        <field name="res_model">consol.account</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_consol_account_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tambahkan akun konsolidasi baru!
            </p>
        </field>
    </record>
</odoo>
