<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_consolidation_wp_export_form" model="ir.ui.view">
        <field name="name">consolidation.wp.export.form</field>
        <field name="model">consolidation.wp.export</field>
        <field name="arch" type="xml">
            <form string="Export Working Paper">
                <sheet>
                    <group>
                        <field name="period_id"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_export_excel" type="object" string="Export to Excel" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_consolidation_wp_export" model="ir.actions.act_window">
        <field name="name">Export Working Paper (Excel)</field>
        <field name="res_model">consolidation.wp.export</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
