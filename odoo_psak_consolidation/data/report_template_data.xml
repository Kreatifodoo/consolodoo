<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- 1. LAPORAN POSISI KEUANGAN KONSOLIDASI (NERACA) -->
    <record id="report_balance_sheet" model="consol.report">
        <field name="name">Laporan Posisi Keuangan Konsolidasi (Neraca)</field>
        <field name="report_type">balance_sheet</field>
        <field name="sequence">10</field>
        <field name="show_entity_columns">True</field>
        <field name="show_elimination_column">True</field>
    </record>

    <!-- Baris Laporan Posisi Keuangan -->
    <record id="rline_bs_h_asset" model="consol.report.line">
        <field name="report_id" ref="report_balance_sheet"/>
        <field name="sequence">10</field>
        <field name="name">ASET</field>
        <field name="level">0</field>
        <field name="line_type">header</field>
        <field name="bold">True</field>
    </record>

    <record id="rline_bs_h_current_asset" model="consol.report.line">
        <field name="report_id" ref="report_balance_sheet"/>
        <field name="sequence">20</field>
        <field name="name">Aset Lancar</field>
        <field name="level">1</field>
        <field name="line_type">header</field>
        <field name="bold">True</field>
    </record>

    <record id="rline_bs_cash" model="consol.report.line">
        <field name="report_id" ref="report_balance_sheet"/>
        <field name="sequence">30</field>
        <field name="name">Kas dan Setara Kas</field>
        <field name="code">CASH</field>
        <field name="level">2</field>
        <field name="line_type">accounts</field>
        <field name="account_ids" eval="[(6, 0, [ref('consol_acc_cash')])]"/>
        <field name="balance_sign">natural</field>
        <field name="note">4</field>
    </record>

    <record id="rline_bs_ar" model="consol.report.line">
        <field name="report_id" ref="report_balance_sheet"/>
        <field name="sequence">40</field>
        <field name="name">Piutang Usaha Pihak Ketiga</field>
        <field name="code">AR</field>
        <field name="level">2</field>
        <field name="line_type">accounts</field>
        <field name="account_ids" eval="[(6, 0, [ref('consol_acc_receivable')])]"/>
        <field name="balance_sign">natural</field>
        <field name="note">5</field>
    </record>

    <record id="rline_bs_ar_ic" model="consol.report.line">
        <field name="report_id" ref="report_balance_sheet"/>
        <field name="sequence">50</field>
        <field name="name">Piutang Antar Perusahaan (Intercompany)</field>
        <field name="code">AR_IC</field>
        <field name="level">2</field>
        <field name="line_type">accounts</field>
        <field name="account_ids" eval="[(6, 0, [ref('consol_acc_ic_receivable')])]"/>
        <field name="balance_sign">natural</field>
        <field name="note">6</field>
    </record>

    <record id="rline_bs_inv" model="consol.report.line">
        <field name="report_id" ref="report_balance_sheet"/>
        <field name="sequence">60</field>
        <field name="name">Persediaan Barang</field>
        <field name="code">INV</field>
        <field name="level">2</field>
        <field name="line_type">accounts</field>
        <field name="account_ids" eval="[(6, 0, [ref('consol_acc_inventory')])]"/>
        <field name="balance_sign">natural</field>
        <field name="note">7</field>
    </record>

    <record id="rline_bs_tot_current_asset" model="consol.report.line">
        <field name="report_id" ref="report_balance_sheet"/>
        <field name="sequence">70</field>
        <field name="name">Jumlah Aset Lancar</field>
        <field name="code">TOT_CA</field>
        <field name="level">1</field>
        <field name="line_type">formula</field>
        <field name="formula">CASH + AR + AR_IC + INV</field>
        <field name="bold">True</field>
        <field name="underline">True</field>
    </record>

    <record id="rline_bs_h_non_current_asset" model="consol.report.line">
        <field name="report_id" ref="report_balance_sheet"/>
        <field name="sequence">80</field>
        <field name="name">Aset Tidak Lancar</field>
        <field name="level">1</field>
        <field name="line_type">header</field>
        <field name="bold">True</field>
    </record>

    <record id="rline_bs_fixed" model="consol.report.line">
        <field name="report_id" ref="report_balance_sheet"/>
        <field name="sequence">90</field>
        <field name="name">Aset Tetap (Nilai Buku Bersih)</field>
        <field name="code">FA</field>
        <field name="level">2</field>
        <field name="line_type">accounts</field>
        <field name="account_ids" eval="[(6, 0, [ref('consol_acc_fixed_assets'), ref('consol_acc_accum_depr')])]"/>
        <field name="balance_sign">natural</field>
        <field name="note">8</field>
    </record>

    <record id="rline_bs_goodwill" model="consol.report.line">
        <field name="report_id" ref="report_balance_sheet"/>
        <field name="sequence">100</field>
        <field name="name">Goodwill Konsolidasi</field>
        <field name="code">GW</field>
        <field name="level">2</field>
        <field name="line_type">accounts</field>
        <field name="account_ids" eval="[(6, 0, [ref('consol_acc_goodwill')])]"/>
        <field name="balance_sign">natural</field>
        <field name="note">9</field>
    </record>

    <record id="rline_bs_inv_sub" model="consol.report.line">
        <field name="report_id" ref="report_balance_sheet"/>
        <field name="sequence">110</field>
        <field name="name">Investasi pada Entitas Anak</field>
        <field name="code">INV_SUB</field>
        <field name="level">2</field>
        <field name="line_type">accounts</field>
        <field name="account_ids" eval="[(6, 0, [ref('consol_acc_investment_sub')])]"/>
        <field name="balance_sign">natural</field>
    </record>

    <record id="rline_bs_tot_assets" model="consol.report.line">
        <field name="report_id" ref="report_balance_sheet"/>
        <field name="sequence">120</field>
        <field name="name">JUMLAH ASET</field>
        <field name="code">TOT_ASSETS</field>
        <field name="level">0</field>
        <field name="line_type">formula</field>
        <field name="formula">TOT_CA + FA + GW + INV_SUB</field>
        <field name="bold">True</field>
        <field name="underline">True</field>
    </record>

    <record id="rline_bs_h_liab_eq" model="consol.report.line">
        <field name="report_id" ref="report_balance_sheet"/>
        <field name="sequence">130</field>
        <field name="name">LIABILITAS DAN EKUITAS</field>
        <field name="level">0</field>
        <field name="line_type">header</field>
        <field name="bold">True</field>
    </record>

    <record id="rline_bs_ap" model="consol.report.line">
        <field name="report_id" ref="report_balance_sheet"/>
        <field name="sequence">140</field>
        <field name="name">Utang Usaha Pihak Ketiga</field>
        <field name="code">AP</field>
        <field name="level">2</field>
        <field name="line_type">accounts</field>
        <field name="account_ids" eval="[(6, 0, [ref('consol_acc_payable')])]"/>
        <field name="balance_sign">reverse</field>
        <field name="note">10</field>
    </record>

    <record id="rline_bs_ap_ic" model="consol.report.line">
        <field name="report_id" ref="report_balance_sheet"/>
        <field name="sequence">150</field>
        <field name="name">Utang Antar Perusahaan (Intercompany)</field>
        <field name="code">AP_IC</field>
        <field name="level">2</field>
        <field name="line_type">accounts</field>
        <field name="account_ids" eval="[(6, 0, [ref('consol_acc_ic_payable')])]"/>
        <field name="balance_sign">reverse</field>
        <field name="note">11</field>
    </record>

    <record id="rline_bs_tot_liab" model="consol.report.line">
        <field name="report_id" ref="report_balance_sheet"/>
        <field name="sequence">160</field>
        <field name="name">Jumlah Liabilitas</field>
        <field name="code">TOT_LIAB</field>
        <field name="level">1</field>
        <field name="line_type">formula</field>
        <field name="formula">AP + AP_IC</field>
        <field name="bold">True</field>
    </record>

    <record id="rline_bs_h_equity" model="consol.report.line">
        <field name="report_id" ref="report_balance_sheet"/>
        <field name="sequence">170</field>
        <field name="name">Ekuitas Yang Dapat Diatribusikan kepada Pemilik Entitas Induk</field>
        <field name="level">1</field>
        <field name="line_type">header</field>
        <field name="bold">True</field>
    </record>

    <record id="rline_bs_equity_parent" model="consol.report.line">
        <field name="report_id" ref="report_balance_sheet"/>
        <field name="sequence">180</field>
        <field name="name">Modal Saham, Agio Saham &amp; Saldo Laba</field>
        <field name="code">EQ_PARENT</field>
        <field name="level">2</field>
        <field name="line_type">accounts</field>
        <field name="account_ids" eval="[(6, 0, [ref('consol_acc_share_capital'), ref('consol_acc_share_premium'), ref('consol_acc_retained_earnings'), ref('consol_acc_cta')])]"/>
        <field name="balance_sign">reverse</field>
        <field name="note">12</field>
    </record>

    <record id="rline_bs_nci_equity" model="consol.report.line">
        <field name="report_id" ref="report_balance_sheet"/>
        <field name="sequence">190</field>
        <field name="name">Kepentingan Non-Pengendali (NCI)</field>
        <field name="code">NCI_EQ</field>
        <field name="level">2</field>
        <field name="line_type">accounts</field>
        <field name="account_ids" eval="[(6, 0, [ref('consol_acc_nci_equity')])]"/>
        <field name="balance_sign">reverse</field>
        <field name="note">13</field>
    </record>

    <record id="rline_bs_curr_ni" model="consol.report.line">
        <field name="report_id" ref="report_balance_sheet"/>
        <field name="sequence">200</field>
        <field name="name">Laba/(Rugi) Periode Berjalan</field>
        <field name="code">CURR_NI</field>
        <field name="level">2</field>
        <field name="line_type">accounts</field>
        <field name="account_ids" eval="[(6, 0, [ref('consol_acc_revenue'), ref('consol_acc_ic_revenue'), ref('consol_acc_cogs'), ref('consol_acc_opex'), ref('consol_acc_depr_exp')])]"/>
        <field name="balance_sign">reverse</field>
        <field name="note">14</field>
    </record>

    <record id="rline_bs_tot_liab_equity" model="consol.report.line">
        <field name="report_id" ref="report_balance_sheet"/>
        <field name="sequence">210</field>
        <field name="name">JUMLAH LIABILITAS DAN EKUITAS</field>
        <field name="code">TOT_LIAB_EQ</field>
        <field name="level">0</field>
        <field name="line_type">formula</field>
        <field name="formula">TOT_LIAB + EQ_PARENT + CURR_NI + NCI_EQ</field>
        <field name="bold">True</field>
        <field name="underline">True</field>
    </record>

    <!-- 2. LAPORAN LABA RUGI & PENGHASILAN KOMPREHENSIF LAIN KONSOLIDASI -->
    <record id="report_profit_loss" model="consol.report">
        <field name="name">Laporan Laba Rugi dan Penghasilan Komprehensif Lain Konsolidasi</field>
        <field name="report_type">profit_loss</field>
        <field name="sequence">20</field>
        <field name="show_entity_columns">True</field>
        <field name="show_elimination_column">True</field>
        <field name="show_nci_split">True</field>
    </record>

    <record id="rline_pl_revenue" model="consol.report.line">
        <field name="report_id" ref="report_profit_loss"/>
        <field name="sequence">10</field>
        <field name="name">Pendapatan dari Penjualan</field>
        <field name="code">REV</field>
        <field name="level">1</field>
        <field name="line_type">accounts</field>
        <field name="account_ids" eval="[(6, 0, [ref('consol_acc_revenue'), ref('consol_acc_ic_revenue')])]"/>
        <field name="balance_sign">reverse</field>
        <field name="note">15</field>
    </record>

    <record id="rline_pl_cogs" model="consol.report.line">
        <field name="report_id" ref="report_profit_loss"/>
        <field name="sequence">20</field>
        <field name="name">Beban Pokok Penjualan (HPP)</field>
        <field name="code">COGS</field>
        <field name="level">1</field>
        <field name="line_type">accounts</field>
        <field name="account_ids" eval="[(6, 0, [ref('consol_acc_cogs')])]"/>
        <field name="balance_sign">natural</field>
        <field name="note">16</field>
    </record>

    <record id="rline_pl_gp" model="consol.report.line">
        <field name="report_id" ref="report_profit_loss"/>
        <field name="sequence">30</field>
        <field name="name">LABA KOTOR (GROSS PROFIT)</field>
        <field name="code">GP</field>
        <field name="level">0</field>
        <field name="line_type">formula</field>
        <field name="formula">REV - COGS</field>
        <field name="bold">True</field>
    </record>

    <record id="rline_pl_opex" model="consol.report.line">
        <field name="report_id" ref="report_profit_loss"/>
        <field name="sequence">40</field>
        <field name="name">Beban Operasional &amp; Umum</field>
        <field name="code">OPEX</field>
        <field name="level">1</field>
        <field name="line_type">accounts</field>
        <field name="account_ids" eval="[(6, 0, [ref('consol_acc_opex'), ref('consol_acc_depr_exp')])]"/>
        <field name="balance_sign">natural</field>
        <field name="note">17</field>
    </record>

    <record id="rline_pl_ni" model="consol.report.line">
        <field name="report_id" ref="report_profit_loss"/>
        <field name="sequence">50</field>
        <field name="name">LABA BERSIH PERIODE BERJALAN</field>
        <field name="code">NI</field>
        <field name="level">0</field>
        <field name="line_type">formula</field>
        <field name="formula">GP - OPEX</field>
        <field name="bold">True</field>
        <field name="underline">True</field>
    </record>

    <record id="rline_pl_nci_share" model="consol.report.line">
        <field name="report_id" ref="report_profit_loss"/>
        <field name="sequence">60</field>
        <field name="name">Diatribusikan kepada: Kepentingan Non-Pengendali (NCI)</field>
        <field name="code">NCI_ATTRIB</field>
        <field name="level">2</field>
        <field name="line_type">accounts</field>
        <field name="account_ids" eval="[(6, 0, [ref('consol_acc_nci_pl')])]"/>
        <field name="balance_sign">natural</field>
    </record>

    <record id="rline_pl_parent_share" model="consol.report.line">
        <field name="report_id" ref="report_profit_loss"/>
        <field name="sequence">70</field>
        <field name="name">Diatribusikan kepada: Pemilik Entitas Induk</field>
        <field name="code">PARENT_SHARE</field>
        <field name="level">2</field>
        <field name="line_type">formula</field>
        <field name="formula">NI - NCI_ATTRIB</field>
        <field name="bold">True</field>
    </record>

    <!-- 3. LAPORAN ARUS KAS KONSOLIDASI (METODE TIDAK LANGSUNG) -->
    <record id="report_cash_flow" model="consol.report">
        <field name="name">Laporan Arus Kas Konsolidasi</field>
        <field name="report_type">cash_flow</field>
        <field name="sequence">30</field>
        <field name="show_entity_columns">True</field>
        <field name="show_elimination_column">True</field>
    </record>

    <record id="rline_cf_h_operating" model="consol.report.line">
        <field name="report_id" ref="report_cash_flow"/>
        <field name="sequence">10</field>
        <field name="name">ARUS KAS DARI AKTIVITAS OPERASI</field>
        <field name="level">0</field>
        <field name="line_type">header</field>
        <field name="bold">True</field>
    </record>

    <record id="rline_cf_net_profit" model="consol.report.line">
        <field name="report_id" ref="report_cash_flow"/>
        <field name="sequence">20</field>
        <field name="name">Laba Bersih Periode Berjalan</field>
        <field name="code">CF_NI</field>
        <field name="level">1</field>
        <field name="line_type">accounts</field>
        <field name="account_ids" eval="[(6, 0, [ref('consol_acc_revenue'), ref('consol_acc_ic_revenue'), ref('consol_acc_cogs'), ref('consol_acc_opex'), ref('consol_acc_depr_exp')])]"/>
        <field name="balance_sign">reverse</field>
    </record>

    <record id="rline_cf_depr" model="consol.report.line">
        <field name="report_id" ref="report_cash_flow"/>
        <field name="sequence">30</field>
        <field name="name">Penyesuaian: Beban Penyusutan</field>
        <field name="code">CF_DEPR</field>
        <field name="level">1</field>
        <field name="line_type">accounts</field>
        <field name="account_ids" eval="[(6, 0, [ref('consol_acc_depr_exp')])]"/>
        <field name="balance_sign">natural</field>
    </record>

    <record id="rline_cf_tot_op" model="consol.report.line">
        <field name="report_id" ref="report_cash_flow"/>
        <field name="sequence">40</field>
        <field name="name">Arus Kas Bersih dari Aktivitas Operasi</field>
        <field name="code">TOT_CF_OP</field>
        <field name="level">0</field>
        <field name="line_type">formula</field>
        <field name="formula">CF_NI + CF_DEPR</field>
        <field name="bold">True</field>
        <field name="underline">True</field>
    </record>

    <!-- 4. LAPORAN PERUBAHAN EKUITAS KONSOLIDASI -->
    <record id="report_equity_changes" model="consol.report">
        <field name="name">Laporan Perubahan Ekuitas Konsolidasi</field>
        <field name="report_type">equity_changes</field>
        <field name="sequence">40</field>
        <field name="show_entity_columns">True</field>
        <field name="show_elimination_column">True</field>
    </record>

    <record id="rline_eq_share_capital" model="consol.report.line">
        <field name="report_id" ref="report_equity_changes"/>
        <field name="sequence">10</field>
        <field name="name">Modal Saham Ditempatkan dan Disetor Penuh</field>
        <field name="code">EQ_CAP</field>
        <field name="level">1</field>
        <field name="line_type">accounts</field>
        <field name="account_ids" eval="[(6, 0, [ref('consol_acc_share_capital')])]"/>
        <field name="balance_sign">reverse</field>
    </record>

    <record id="rline_eq_premium" model="consol.report.line">
        <field name="report_id" ref="report_equity_changes"/>
        <field name="sequence">20</field>
        <field name="name">Tambahan Modal Disetor (Agio Saham)</field>
        <field name="code">EQ_PREM</field>
        <field name="level">1</field>
        <field name="line_type">accounts</field>
        <field name="account_ids" eval="[(6, 0, [ref('consol_acc_share_premium')])]"/>
        <field name="balance_sign">reverse</field>
    </record>

    <record id="rline_eq_re" model="consol.report.line">
        <field name="report_id" ref="report_equity_changes"/>
        <field name="sequence">30</field>
        <field name="name">Saldo Laba (Retained Earnings)</field>
        <field name="code">EQ_RE</field>
        <field name="level">1</field>
        <field name="line_type">accounts</field>
        <field name="account_ids" eval="[(6, 0, [ref('consol_acc_retained_earnings')])]"/>
        <field name="balance_sign">reverse</field>
    </record>

    <record id="rline_eq_nci" model="consol.report.line">
        <field name="report_id" ref="report_equity_changes"/>
        <field name="sequence">40</field>
        <field name="name">Kepentingan Non-Pengendali (NCI)</field>
        <field name="code">EQ_NCI</field>
        <field name="level">1</field>
        <field name="line_type">accounts</field>
        <field name="account_ids" eval="[(6, 0, [ref('consol_acc_nci_equity')])]"/>
        <field name="balance_sign">reverse</field>
    </record>

    <record id="rline_eq_total" model="consol.report.line">
        <field name="report_id" ref="report_equity_changes"/>
        <field name="sequence">50</field>
        <field name="name">JUMLAH EKUITAS KONSOLIDASI</field>
        <field name="code">TOT_EQ</field>
        <field name="level">0</field>
        <field name="line_type">formula</field>
        <field name="formula">EQ_CAP + EQ_PREM + EQ_RE + EQ_NCI</field>
        <field name="bold">True</field>
        <field name="underline">True</field>
    </record>

    <!-- 5. KERTAS KERJA KONSOLIDASI (WORKSHEET) -->
    <record id="report_worksheet" model="consol.report">
        <field name="name">Kertas Kerja Konsolidasi (Worksheet)</field>
        <field name="report_type">worksheet</field>
        <field name="sequence">50</field>
        <field name="show_entity_columns">True</field>
        <field name="show_elimination_column">True</field>
    </record>

    <record id="rline_ws_assets" model="consol.report.line">
        <field name="report_id" ref="report_worksheet"/>
        <field name="sequence">10</field>
        <field name="name">Total Aset</field>
        <field name="code">WS_ASSETS</field>
        <field name="level">1</field>
        <field name="line_type">accounts</field>
        <field name="account_ids" eval="[(6, 0, [ref('consol_acc_cash'), ref('consol_acc_receivable'), ref('consol_acc_ic_receivable'), ref('consol_acc_inventory'), ref('consol_acc_fixed_assets'), ref('consol_acc_accum_depr'), ref('consol_acc_goodwill')])]"/>
        <field name="balance_sign">natural</field>
        <field name="bold">True</field>
    </record>

    <record id="rline_ws_liab" model="consol.report.line">
        <field name="report_id" ref="report_worksheet"/>
        <field name="sequence">20</field>
        <field name="name">Total Liabilitas</field>
        <field name="code">WS_LIAB</field>
        <field name="level">1</field>
        <field name="line_type">accounts</field>
        <field name="account_ids" eval="[(6, 0, [ref('consol_acc_payable'), ref('consol_acc_ic_payable')])]"/>
        <field name="balance_sign">reverse</field>
        <field name="bold">True</field>
    </record>

    <record id="rline_ws_equity" model="consol.report.line">
        <field name="report_id" ref="report_worksheet"/>
        <field name="sequence">30</field>
        <field name="name">Total Ekuitas</field>
        <field name="code">WS_EQ</field>
        <field name="level">1</field>
        <field name="line_type">accounts</field>
        <field name="account_ids" eval="[(6, 0, [ref('consol_acc_share_capital'), ref('consol_acc_share_premium'), ref('consol_acc_retained_earnings'), ref('consol_acc_nci_equity')])]"/>
        <field name="balance_sign">reverse</field>
        <field name="bold">True</field>
    </record>
</odoo>
