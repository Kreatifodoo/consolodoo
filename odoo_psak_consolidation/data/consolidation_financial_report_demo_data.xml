<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- 1. Consolidation Financial Report -->
        <record id="demo_report_pnl_consolidation" model="consolidation.report">
            <field name="name">Profit &amp; Loss Consolidation</field>
            <field name="code">PNL_CONS</field>
        </record>

        <!-- 2. Report Lines -->
        
        <!-- 1. Revenue -->
        <record id="demo_line_revenue" model="consolidation.report.line">
            <field name="name">Pendapatan (Revenue)</field>
            <field name="code">REV</field>
            <field name="report_id" ref="demo_report_pnl_consolidation"/>
            <field name="line_type">view</field>
            <field name="sign">-1</field>
            <field name="sequence">10</field>
        </record>

        <record id="demo_line_sales" model="consolidation.report.line">
            <field name="name">Penjualan Produk</field>
            <field name="code">REV_SALES</field>
            <field name="report_id" ref="demo_report_pnl_consolidation"/>
            <field name="parent_id" ref="demo_line_revenue"/>
            <field name="line_type">accounts</field>
            <field name="sign">-1</field>
            <field name="sequence">11</field>
        </record>

        <record id="demo_line_other_income" model="consolidation.report.line">
            <field name="name">Pendapatan Jasa</field>
            <field name="code">REV_OTHER</field>
            <field name="report_id" ref="demo_report_pnl_consolidation"/>
            <field name="parent_id" ref="demo_line_revenue"/>
            <field name="line_type">accounts</field>
            <field name="sign">-1</field>
            <field name="sequence">12</field>
        </record>

        <!-- 2. COGS -->
        <record id="demo_line_cogs" model="consolidation.report.line">
            <field name="name">Harga Pokok Penjualan (COGS)</field>
            <field name="code">COGS</field>
            <field name="report_id" ref="demo_report_pnl_consolidation"/>
            <field name="line_type">view</field>
            <field name="sign">1</field>
            <field name="sequence">20</field>
        </record>

        <record id="demo_line_cogs_raw" model="consolidation.report.line">
            <field name="name">Biaya Bahan Baku</field>
            <field name="code">COGS_RAW</field>
            <field name="report_id" ref="demo_report_pnl_consolidation"/>
            <field name="parent_id" ref="demo_line_cogs"/>
            <field name="line_type">accounts</field>
            <field name="sign">1</field>
            <field name="sequence">21</field>
        </record>

        <record id="demo_line_cogs_labor" model="consolidation.report.line">
            <field name="name">Biaya Tenaga Kerja Langsung</field>
            <field name="code">COGS_LABOR</field>
            <field name="report_id" ref="demo_report_pnl_consolidation"/>
            <field name="parent_id" ref="demo_line_cogs"/>
            <field name="line_type">accounts</field>
            <field name="sign">1</field>
            <field name="sequence">22</field>
        </record>

        <!-- 3. Gross Profit (Formula) -->
        <record id="demo_line_gross_profit" model="consolidation.report.line">
            <field name="name">Laba Kotor (Gross Profit)</field>
            <field name="code">GP</field>
            <field name="report_id" ref="demo_report_pnl_consolidation"/>
            <field name="line_type">sum</field>
            <field name="sign">-1</field>
            <field name="sequence">30</field>
            <field name="sum_line_ids" eval="[(6, 0, [ref('demo_line_revenue'), ref('demo_line_cogs')])]"/>
        </record>

        <!-- 4. Operating Expenses -->
        <record id="demo_line_expenses" model="consolidation.report.line">
            <field name="name">Biaya Operasional (Expenses)</field>
            <field name="code">OPEX</field>
            <field name="report_id" ref="demo_report_pnl_consolidation"/>
            <field name="line_type">view</field>
            <field name="sign">1</field>
            <field name="sequence">40</field>
        </record>

        <record id="demo_line_salaries" model="consolidation.report.line">
            <field name="name">Gaji Karyawan</field>
            <field name="code">OPEX_SAL</field>
            <field name="report_id" ref="demo_report_pnl_consolidation"/>
            <field name="parent_id" ref="demo_line_expenses"/>
            <field name="line_type">accounts</field>
            <field name="sign">1</field>
            <field name="sequence">41</field>
        </record>

        <record id="demo_line_rent" model="consolidation.report.line">
            <field name="name">Biaya Sewa dan Listrik</field>
            <field name="code">OPEX_RENT</field>
            <field name="report_id" ref="demo_report_pnl_consolidation"/>
            <field name="parent_id" ref="demo_line_expenses"/>
            <field name="line_type">accounts</field>
            <field name="sign">1</field>
            <field name="sequence">42</field>
        </record>

        <!-- 5. Net Profit (Formula) -->
        <record id="demo_line_net_profit" model="consolidation.report.line">
            <field name="name">Laba Bersih (Net Profit)</field>
            <field name="code">NP</field>
            <field name="report_id" ref="demo_report_pnl_consolidation"/>
            <field name="line_type">sum</field>
            <field name="sign">-1</field>
            <field name="sequence">50</field>
            <field name="sum_line_ids" eval="[(6, 0, [ref('demo_line_gross_profit'), ref('demo_line_expenses')])]"/>
        </record>

    </data>
</odoo>
