<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_consol_import_company_coa_wizard_form" model="ir.ui.view">
        <field name="name">consol.import.company.coa.wizard.form</field>
        <field name="model">consol.import.company.coa.wizard</field>
        <field name="arch" type="xml">
            <form string="Salin Master Akun dari Perusahaan">
                <sheet>
                    <p class="text-muted">
                        Panduan ini akan menyalin seluruh Bagan Akun dari perusahaan Odoo yang dipilih ke dalam 
                        <strong>Bagan Akun Konsolidasi</strong> serta secara otomatis memetakan akun pada seluruh entitas yang ada.
                    </p>
                    <group>
                        <field name="company_id" options="{'no_create': True}"/>
                        <field name="auto_map_entities"/>
                        <field name="update_existing"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Salin &amp; Petakan Otomatis"
                            name="action_import_and_map"
                            type="object"
                            class="btn-primary"/>
                    <button string="Batal" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_consol_import_company_coa_wizard" model="ir.actions.act_window">
        <field name="name">Salin Master Akun dari Perusahaan</field>
        <field name="res_model">consol.import.company.coa.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
