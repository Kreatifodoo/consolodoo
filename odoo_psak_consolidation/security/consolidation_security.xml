<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. Auditor (Read-Only) -->
    <record id="group_consolidation_auditor" model="res.groups">
        <field name="name">Consolidation: Auditor (Read-Only)</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- 2. User (Operator) -->
    <record id="group_consolidation_user" model="res.groups">
        <field name="name">Consolidation: User (Operator)</field>
        <field name="implied_ids" eval="[(4, ref('group_consolidation_auditor'))]"/>
    </record>

    <!-- 3. Reviewer -->
    <record id="group_consolidation_reviewer" model="res.groups">
        <field name="name">Consolidation: Reviewer</field>
        <field name="implied_ids" eval="[(4, ref('group_consolidation_user'))]"/>
    </record>

    <!-- 4. Manager -->
    <record id="group_consolidation_manager" model="res.groups">
        <field name="name">Consolidation: Manager (Administrator)</field>
        <field name="implied_ids" eval="[(4, ref('group_consolidation_reviewer'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Record Rules -->
    <record id="consol_group_rule_user" model="ir.rule">
        <field name="name">Consolidation Group User Access Rule</field>
        <field name="model_id" ref="model_consol_group"/>
        <field name="domain_force">['|', ('id', 'in', user.consol_group_ids.ids), ('create_uid', '=', user.id)] if user.consol_group_ids else [(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_consolidation_auditor'))]"/>
    </record>

    <record id="consol_period_rule_user" model="ir.rule">
        <field name="name">Consolidation Period User Access Rule</field>
        <field name="model_id" ref="model_consol_period"/>
        <field name="domain_force">['|', ('group_id', 'in', user.consol_group_ids.ids), ('create_uid', '=', user.id)] if user.consol_group_ids else [(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_consolidation_auditor'))]"/>
    </record>
</odoo>
